{
  "name": "llm-docs-generator",
  "version": "1.0.0",
  "description": "Multi-format LLM documentation generator supporting OpenRef YAML, Markdown/DocC, and more",
  "type": "module",
  "keywords": [
    "llm",
    "llms",
    "llms-txt",
    "llms.txt",
    "llm-docs",
    "ai",
    "ai-agents",
    "agents",
    "agent",
    "rag",
    "retrieval-augmented-generation",
    "semantic-chunking",
    "chunking",
    "documentation",
    "documentation-generator",
    "docs",
    "docs-generator",
    "generator",
    "openref",
    "openapi",
    "swagger",
    "markdown",
    "mdx",
    "rst",
    "restructuredtext",
    "docc",
    "html",
    "claude",
    "anthropic",
    "gpt",
    "openai",
    "swift",
    "supabase",
    "typescript",
    "cli"
  ],
  "author": "Zyepher",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "llm-docs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "config",
    "skills/llm-docs-generator/SKILL.md",
    "skills/repo-docs-discovery/SKILL.md",
    "AGENT_CONTEXT.md",
    "index.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean --minify --external typescript",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint ./src ./tests",
    "lint:fix": "biome lint --write ./src ./tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "generate": "tsx src/cli.ts generate",
    "list": "tsx src/cli.ts list-sdks",
    "validate": "tsx src/cli.ts validate",
    "prepublishOnly": "npm run lint && npm run type-check && npm run build && npm run test",
    "clean": "rm -rf dist output/*/"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "js-yaml": "^4.2.0",
    "marked": "^11.1.1",
    "ora": "^8.0.1",
    "typescript": "^5.3.3",
    "undici": "^6.27.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.19",
    "@vitest/coverage-v8": "^1.2.2",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "vitest": "^1.2.2"
  }
}
